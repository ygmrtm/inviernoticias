		{
			"name": "05. AI Analysis (Gemini + Grounding)",
			"item": [
				{
					"name": "Analyze Direct Text (Custom Input)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Científicos de la UNAM descubren que los tacos al pastor curan el mal de amores\",\n  \"text\": \"Un equipo multidisciplinario de taqueros e investigadores de la máxima casa de estudios determinó que una orden de cinco tacos con copia, cilantro, cebolla y salsa de la que sí pica provoca una liberación masiva de endorfinas que elimina el dolor del desamor en menos de 15 minutos.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/analyze",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"analyze"
							]
						},
						"description": "Envía texto libre (noticia, aviso o rumor) para ser analizado directamente por Google Gemini 2.5 Flash con Search Grounding para contrastar fuentes en tiempo real."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Analysis structure matches schema\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property(\"isSatire\");",
									"    pm.expect(jsonData).to.have.property(\"truthScore\");",
									"    pm.expect(jsonData).to.have.property(\"sarcasmScore\");",
									"    pm.expect(jsonData).to.have.property(\"mexicoMagicoAward\");",
									"    pm.expect(jsonData).to.have.property(\"analysisSummary\");",
									"    pm.expect(jsonData).to.have.property(\"foreignerExplanation\");",
									"    pm.expect(jsonData).to.have.property(\"relatedSources\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
