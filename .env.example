# Gemini API Key (Required for AI detection features)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Backup Gemini API Key (Fallback if primary account exceeds quota 429)
GEMINI_BACKUP_API_KEY=YOUR_BACKUP_GEMINI_API_KEY_HERE

# Notion API Configuration (Optional)
NOTION_TOKEN=YOUR_NOTION_TOKEN_HERE
NOTION_DATABASE_ID=YOUR_NOTION_DATABASE_ID_HERE

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_RETRY_DELAY_MS=30000
RABBITMQ_MAX_RETRIES=3

# CronJob & Background Workers
ENABLE_RABBITMQ=true
ENABLE_WORKERS=true
ENABLE_CRON=true
CRON_INTERVAL_HOURS=24
# CRON_FEED_ID=1  # Optional: set to restrict to a single feed ID; omit to process all feeds
